# ── Git Root .gitignore for ACEA Platform ────────────────────────────────

# Environment secrets — NEVER commit
*.env
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/settings.json
*.iml

# ── Backend ───────────────────────────────────────────────────────────────
backend/target/
backend/*.log
backend/logs/

# ── Frontend ──────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ── Logs ──────────────────────────────────────────────────────────────────
logs/
*.log

# ── AI Service ────────────────────────────────────────────────────────────
ai_service/__pycache__/
ai_service/*.pyc
ai_service/.venv/
ai_service/venv/
