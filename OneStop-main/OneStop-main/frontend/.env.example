# ── ACEA Frontend Environment Variables ───────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# API Base URL — proxied to Spring Boot in dev (via vite.config.ts)
VITE_API_URL=/api/v1

# App metadata
VITE_APP_NAME=ACEA Platform
VITE_APP_VERSION=1.0.0
